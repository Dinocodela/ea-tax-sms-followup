# Defaults run entirely locally without credentials or dependencies.
DATA_MODE=demo
TEST_MODE=true
PORT=8050
LOCK_PORT=8051
POLL_SECONDS=120
MAX_LATENESS_MINUTES=1440

# Set DATA_MODE=live to read real APIs but keep TEST_MODE=true initially.
MIXMAX_API_TOKEN=
RC_SERVER_URL=https://platform.ringcentral.com
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
RC_SENDER_NUMBER=
# Real sends are limited to these comma-separated E.164 numbers.
# Example: +12025550123. Use only your own agreed test numbers.
LIVE_ALLOWED_NUMBERS=

# AI drafting of SMS texts from each stage email (platform.openai.com > API keys).
OPENAI_API_KEY=
# Optional: which ChatGPT model drafts the texts (default gpt-5-mini).
OPENAI_MODEL=
